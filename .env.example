# GraphFlow Environment Variables Template
# Copy this file to .env.local to configure local overrides

# Optional: Google Gemini API Key for AI Architecture Generator
# If empty, GraphFlow uses its built-in heuristic synthesis engine
VITE_GEMINI_API_KEY=

# Optional: Supabase configuration (for cloud sync & auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Serverless Webhook Configuration (for Vercel / Lemon Squeezy automation)
# Supabase Service Role Key (used in api/webhook.ts only, never exposed to frontend)
SUPABASE_SERVICE_ROLE_KEY=

# Lemon Squeezy Webhook Secret (from Lemon Squeezy Dashboard -> Settings -> Webhooks)
LEMONSQUEEZY_WEBHOOK_SECRET=
